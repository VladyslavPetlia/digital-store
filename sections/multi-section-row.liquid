{{ 'multi-section-row.css' | asset_url | stylesheet_tag }}

<div class="multi-section-row_container page-width">
  {% for block in section.blocks %}
    <div
      class="section-row-item"
      style="color: {{ section.settings.text_color }}; background: {{ section.settings.background_color }}"
    >
      <div
        class="multi-section-row_content"
        style="align-items: {{ section.settings.block-item_content }}; text-align: {{ section.settings.block-item_content }};"
      >
        <div class="multi-section-row_image-container">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'eager' }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'multi-section-row_image-container placeholder-svg' }}
          {% endif %}
        </div>
        <div class="multi-section-row_text-container">
          {% if block.settings.title != blank %}
            <h2 class="multi-section-row_title" style="color: {{ section.settings.text_color }}">
              {{ block.settings.title }}
            </h2>
          {% endif %}
          {% if block.settings.description != blank %}
            <div class="multi-section-row_rich-text">
              {{ block.settings.description }}
            </div>
          {% endif %}
        </div>
        <div class="multi-section-row_link">
          {% if block.settings.url != blank %}
            <a
              href="{{ block.settings.url }}"
              class="multi-section-row_link"
              style="color: {{ section.settings.text_color }}"
            >
              {{- block.settings.link_text -}}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Multi Section",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "select",
      "id": "block-item_content",
      "label": "Block Item Content",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center",
      "info": "Align Items in Block"
    }
  ],
  "blocks": [
    {
      "type": "multi-section",
      "name": "Section",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "range",
          "id": "title_size",
          "min": 16,
          "max": 40,
          "step": 1,
          "unit": "px",
          "label": "Title Size",
          "default": 16
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Some Description text</p>"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL",
          "default": "/collections"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi Section Row",
      "blocks": [
        {
          "type": "multi-section"
        },
        {
          "type": "multi-section"
        },
        {
          "type": "multi-section"
        },
        {
          "type": "multi-section"
        }
      ]
    }
  ]
}
{% endschema %}
